# UNUSED on the current host — kept as the "no nginx" alternative.
#
# whisperingorion.dev already runs nginx + certbot on ports 80/443, so the
# deployed setup terminates TLS in the host's nginx and this Caddy service is
# not started (see the note where it used to be in docker-compose.api.yml, and
# deploy/nginx/jwel.conf.template for the config actually in use).
#
# To switch back to Caddy-as-edge: stop nginx, re-add the caddy service to the
# app stack, and remove the `ports:` blocks from api and web.
#
# Automatic HTTPS via Let's Encrypt. Replace both domains and the email below.
# Requires real domains pointed at this host (A records) — Let's Encrypt
# cannot issue a certificate for a bare IP address.
{
	email admin@yourdomain.com
}

api.yourdomain.com {
	encode gzip

	# Stripe signature verification hashes the RAW body. Caddy's reverse_proxy
	# streams bytes through untouched, which is what we need — do not add any
	# body-rewriting directive above this line.
	reverse_proxy api:4000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Defence in depth: main.ts no longer mounts Swagger when
	# NODE_ENV=production, so /docs should already 404. This keeps it closed
	# even if the API is started with the wrong NODE_ENV.
	@docs path /docs*
	respond @docs 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

shop.yourdomain.com {
	encode gzip

	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
