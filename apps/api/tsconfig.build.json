{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pinned explicitly. Without it TypeScript infers rootDir from the common
    // ancestor of all inputs, so adding any .ts file outside src/ (e.g.
    // scripts/create-admin.ts) silently relocates the output to dist/src/…,
    // breaking `start:prod` (node dist/main.js) and the Docker CMD.
    "rootDir": "./src",
    // Force off for builds. tsconfig.json enables `incremental` (fine for the
    // IDE/tsc --watch), but nest-cli.json sets `deleteOutDir: true`, which wipes
    // dist/ on every build. Incremental then reads the leftover .tsbuildinfo,
    // concludes nothing changed, and emits NOTHING — leaving an empty dist/ and
    // "Cannot find module dist/main" on `nest start`/`start:prod`. Disabling it
    // here makes every build a full, deterministic emit.
    "incremental": false
  },
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
