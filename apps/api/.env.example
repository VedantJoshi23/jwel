# Jwel API — environment template. Copy to `.env` and fill in.
#   cp .env.example .env
#
# Values are validated at boot by src/config/env.validation.ts. Anything marked
# REQUIRED (prod) crashes the app on startup if missing when NODE_ENV=production
# — deliberately, because each one fails silently and confusingly otherwise.

# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=4000

# REQUIRED. Postgres connection string.
DATABASE_URL="postgresql://jwel:jwel@localhost:5432/jwel?schema=public"

# ---------------------------------------------------------------- auth
# REQUIRED. Generate with: openssl rand -base64 48
# Production rejects both the dev placeholder below and anything under 32 chars.
JWT_SECRET="local-dev-secret-not-for-production"
JWT_ACCESS_TOKEN_TTL="3600s"

# ---------------------------------------------------------------- web
# REQUIRED (prod). Comma-separated exact origins allowed to call the API.
# An empty value blocks every browser request while the API still boots — the
# single most confusing misconfiguration in this service, hence the hard check.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Where OAuth callbacks redirect the browser after login.
FRONTEND_URL="http://localhost:3000"

# ---------------------------------------------------------------- storage
# `filesystem` writes to UPLOADS_DIR and serves via the API at /uploads/.
# `s3` uploads to AWS_S3_BUCKET and serves directly from S3/CDN.
STORAGE_PROVIDER=filesystem
UPLOADS_DIR=./uploads

# REQUIRED (prod). Public origin of THIS api, used to build media URLs that get
# handed to browsers. With filesystem storage every product image URL is built
# from this, so a localhost value in production means every image 404s. Must
# also be listed in apps/web/next.config.mjs `images.remotePatterns`.
PUBLIC_BASE_URL="http://localhost:4000"

# Only read when STORAGE_PROVIDER=s3. Credentials come from the AWS default
# chain (instance role / AWS_ACCESS_KEY_ID+AWS_SECRET_ACCESS_KEY), not from here.
# AWS_S3_BUCKET=
# AWS_REGION=
# CDN_BASE_URL=

# ---------------------------------------------------------------- payments
# Razorpay is the sole provider (ADR-0005). All three must be set together.
# When absent the app boots with a mock provider and simulates payments; when
# NODE_ENV=production it refuses to start without them, so real orders can
# never be marked paid without money moving.
#
# KEY_ID is PUBLIC — it is sent to the browser to open the Checkout modal.
# The other two are server-only and must never be copied into a NEXT_PUBLIC_*
# variable, which Next.js inlines into the client bundle.
#
# The webhook secret is chosen by you when creating the webhook in the Razorpay
# dashboard and is never shown again — record it before saving.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Staging-only escape hatch, for a production-shaped deployment whose gateway
# account does not exist yet (Razorpay onboarding takes days and needs the
# client's business documents). Set to exactly 'simulated' and checkout
# completes through the
# mock provider: orders reach CONFIRMED with NO money moving.
#
# MUST be removed before the shop takes real orders, and MUST be paired with
# NEXT_PUBLIC_DEMO_MODE=true on the web image so the storefront says so.
# Any value other than 'simulated' is rejected at boot rather than ignored.
# See RUNBOOK §13.
# PAYMENTS_MODE=simulated

# ---------------------------------------------------------------- search
# Optional. Absent/unreachable Elasticsearch degrades to the Postgres search
# fallback (see SearchService) rather than failing.
# ELASTICSEARCH_NODE="http://localhost:9200"

# ---------------------------------------------------------------- oauth
# Optional. Each provider's routes return a 4xx until its pair is configured
# (see OAuthConfiguredGuard).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_CALLBACK_URL="http://localhost:4000/api/v1/auth/facebook/callback"
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/apple/callback"

# ---------------------------------------------------------------- admin bootstrap
# Read only by `pnpm admin:create` (scripts/create-admin.ts), never by the app.
# Creates or promotes the account the client uses to manage the catalogue.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME="Administrator"

# ---------------------------------------------------------------- observability
# Optional (ADR-0002). Absent means instrument.ts never calls Sentry.init, so
# every Sentry.captureException call in the app (AllExceptionsFilter) is a
# complete no-op — no placeholder DSN needed for local dev, CI, or a
# deployment that hasn't set up a Sentry project yet.
# SENTRY_DSN=
# Defaults to NODE_ENV when unset.
# SENTRY_ENVIRONMENT=
# Defaults to no release tag when unset. Set to the deployed git SHA (see
# deploy/README.md step 1) for per-release error tracking.
# SENTRY_RELEASE=
